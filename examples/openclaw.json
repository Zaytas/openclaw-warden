{
  "_comment": "This file shows two example configurations for openclaw-warden.",
  "_comment2": "Add the relevant sections to your openclaw.json.",

  "minimal_example": {
    "_description": "Zero config — just register the plugin. All rules use sensible defaults.",
    "plugins": {
      "load": {
        "paths": ["~/.openclaw/plugins"]
      },
      "entries": {
        "warden": {
          "enabled": true
        }
      }
    }
  },

  "full_example": {
    "_description": "All options shown with non-default values for demonstration.",
    "plugins": {
      "load": {
        "paths": ["~/.openclaw/plugins"]
      },
      "entries": {
        "warden": {
          "enabled": true,
          "config": {
            "fileEditLimit": {
              "enabled": true,
              "maxFiles": 2,
              "tools": ["edit", "write"]
            },
            "taskToolLimit": {
              "enabled": true,
              "maxCalls": 4,
              "tools": ["edit", "write", "exec", "browser"]
            },
            "healthCheck": {
              "enabled": true,
              "restartPatterns": [
                "docker restart",
                "docker compose restart",
                "docker-compose restart",
                "systemctl restart",
                "pm2 restart",
                "service restart"
              ],
              "successPatterns": [
                "healthy",
                "\"status\":\"ok\"",
                "\"status\": \"ok\"",
                "health check passed",
                "is healthy",
                "is ready",
                "service is running",
                "started successfully"
              ],
              "successStatusCodes": [200]
            },
            "parallelFirst": {
              "enabled": true,
              "message": "Before dispatching subagents, decompose the task into independent parallel workstreams."
            }
          }
        }
      }
    }
  }
}
